{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "7 days",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update tool versions declared in GitHub Actions workflow env blocks",
      "fileMatch": ["^\\.github/workflows/.+\\.ya?ml$"],
      "matchStrings": [
        "[ \\t]*# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[A-Za-z0-9_./-]+)(?: versioning=(?<versioning>[a-z0-9-]+))?[ \\t]*\\r?\\n[ \\t]*\\S+_VERSION:[ \\t]*['\"]?(?<currentValue>v?[0-9A-Za-z.+_-]+)['\"]?[ \\t]*(?:\\r\\n|\\r|\\n|$)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Update annotated reusable workflow input default versions",
      "fileMatch": ["^\\.github/workflows/.+\\.ya?ml$"],
      "matchStrings": [
        "[ \\t]*# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[A-Za-z0-9_./-]+)(?: versioning=(?<versioning>[a-z0-9-]+))?[ \\t]*\\r?\\n[ \\t]*default:[ \\t]*['\"]?(?<currentValue>v?[0-9A-Za-z.+_-]+)['\"]?[ \\t]*(?:\\r\\n|\\r|\\n|$)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Automatically merge minor and patch-level updates",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Require review for workflow tool versions updated by regex managers",
      "matchManagers": ["custom.regex"],
      "automerge": false
    },
    {
      "description": "Keep the pinned yq/gomplate SHA-256 checksums in ci.yml in sync with version bumps. Requires the Renovate app admin to allow this command via the global allowedCommands option; until then, the update-readme-md job's checksum verification still fails closed on any mismatch.",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["mikefarah/yq", "hairyhenderson/gomplate"],
      "postUpgradeTasks": {
        "commands": ["./.github/scripts/sync-tool-checksums.sh"],
        "fileFilters": [".github/workflows/ci.yml"],
        "executionMode": "branch"
      }
    }
  ]
}
