#!/usr/bin/env bash
# Fake `curl` for sync-tool-checksums.bats: serves fixture checksum files
# instead of hitting the network, keyed on the requested release asset URL.
# Controlled by GOMPLATE_CHECKSUMS_FIXTURE so tests can swap in an invalid
# upstream response.

set -euo pipefail

FIXTURE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GOMPLATE_CHECKSUMS_FIXTURE="${GOMPLATE_CHECKSUMS_FIXTURE:-gomplate_checksums}"

output=""
url="${*: -1}"
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  if [[ "${args[${i}]}" == "--output" ]]; then
    output="${args[$((i + 1))]}"
  fi
done

case "${url}" in
  *checksums_hashes_order)
    cp "${FIXTURE_DIR}/yq_checksums_hashes_order" "${output}"
    ;;
  https://github.com/mikefarah/yq/*/checksums)
    cp "${FIXTURE_DIR}/yq_checksums" "${output}"
    ;;
  https://github.com/hairyhenderson/gomplate/*checksums-*_sha256.txt)
    cp "${FIXTURE_DIR}/${GOMPLATE_CHECKSUMS_FIXTURE}" "${output}"
    ;;
  *)
    echo "fake curl: unexpected URL: ${url}" >&2
    exit 1
    ;;
esac
